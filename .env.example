# Database
DATABASE_URL=postgres://singulari:singulari_pass@db:5432/singulari_news

# JWT
JWT_SECRET_KEY=<CHAVE_SEGURA_MINIMO_32_CARACTERES>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_RESET_TOKEN_EXPIRE_MINUTES=15

# Redis
REDIS_URL=redis://redis:6379

# Email (Resend)
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=newsletter@singulari.com.br

# AI — consumer uses Gemini to generate article summaries
AI_API_KEY=<GEMINI_API_KEY>
AI_MODEL=gemini-2.0-flash-lite

# Agent — AI fallback classifier (Anthropic Claude)
AGENT_AI_API_KEY=<ANTHROPIC_API_KEY>

# Agent paths
AGENT_SCHEDULER_INTERVAL_MINUTES=5
AGENT_QUEUE_PATH=data/queue
AGENT_INBOX_PATH=data/inbox
AGENT_PROCESSED_PATH=data/processed
